# Cloudflare Pages headers for PWA
# This file ensures proper PWA behavior when hosted on Cloudflare Pages

# Service Worker
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

# PWA Manifest
/manifest.json
  Cache-Control: public, max-age=0, must-revalidate
  Content-Type: application/manifest+json

# PWA Icons
/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=31536000, immutable

# Static assets
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# HTML files
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# API routes (proxy to Workers)
/api/*
  X-Forwarded-Host: http.host
  X-Forwarded-Proto: https