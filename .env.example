# Demo mode: leave empty (uses mockData in the browser)
# Production / local Worker API:
# VITE_API_BASE_URL="http://localhost:8787"

# Production uses same-origin /api (no env var needed when deployed)

# ---------------------------------------------------------------------------
# SECURITY: never add secrets here. Any `VITE_`-prefixed variable is inlined
# into the public JavaScript bundle and is readable by every visitor.
#
# Super Admin credentials are Worker-side only:
#   wrangler secret put SUPERADMIN_PHONE
#   wrangler secret put SUPERADMIN_PIN
#   wrangler secret put SUPERADMIN_USERNAME
#   wrangler secret put SUPERADMIN_PASSWORD
# ---------------------------------------------------------------------------
