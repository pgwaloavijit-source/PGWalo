{
  "name": "pgwalo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:api": "tsx server.ts",
    "dev:worker": "wrangler dev",
    "build": "vite build",
    "build:worker": "tsc -p tsconfig.worker.json",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js worker",
    "lint": "tsc --noEmit",
    "deploy": "npm run deploy:worker && npm run deploy:pages",
    "deploy:worker": "wrangler deploy",
    "deploy:pages": "npm run build && wrangler pages deploy dist --project-name=pgwalo --commit-dirty=true",
    "d1:create": "wrangler d1 create pgwalo-db",
    "d1:migrate": "wrangler d1 execute pgwalo-db --remote --file=./database/schema.sql",
    "r2:create": "wrangler r2 bucket create pgwalo-media",
    "test:worker": "npx tsx scripts/test-worker.ts",
    "test:db": "wrangler d1 execute pgnest-db --file=./database/test-schema.sql",
    "local:setup": "echo 'Setting up local environment...' && npm install && echo 'VITE_API_BASE_URL=\"http://localhost:8787\"' > .env",
    "local:setup:unix": "bash scripts/local-setup.sh",
    "local:db:init": "wrangler d1 execute pgnest-db --local --file=./database/schema.sql && npx tsx database/migrate-data.ts > database/data-migration.sql && wrangler d1 execute pgnest-db --local --file=./database/data-migration.sql",
    "local:db:reset": "rm -rf .wrangler/state/v3/d1/miniflare-D1DatabaseObject && npm run local:db:init"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241227.0",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^8.2.2",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-pwa": "^1.3.0",
    "wrangler": "^3.94.0"
  }
}
